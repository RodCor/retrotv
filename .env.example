# Copy to .env and adjust for your deployment.
# ----- Database -----
DB_ROOT_PASSWORD=arcturus_root_pw
DB_USER=arcturus_user
DB_PASSWORD=arcturus_pw
DB_NAME=habbo
DB_PORT=13306

# ----- CMS -----
# Generate a strong secret, e.g.:  openssl rand -hex 32
SESSION_SECRET=change-me-in-production-0000000000000000
HOTEL_NAME=RetroTV
# Public URL of the Nitro client (what players' browsers hit).
CLIENT_URL=http://127.0.0.1:1080
# Avatar imaging endpoint for CMS thumbnails. Defaults to the public Habbo
# imager (renders any standard figure). Point at a self-hosted imager to keep
# everything on your own domain. In-game avatars are rendered by the client.
IMAGING_URL=https://www.habbo.com/habbo-imaging
# Minimum users.rank considered staff (can access /admin CRM).
ADMIN_MIN_RANK=5

# Hotel language for in-game texts. 'es' uses the bundled official Spanish
# external texts (langs/external_flash_texts_es.txt); 'en' keeps English.
# `make setup` applies it; run `make assets` to (re)generate.
HOTEL_LANG=es
