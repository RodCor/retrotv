# Copy to .env and adjust for your deployment.
#
# `make setup` (or scripts/setup.sh) creates .env from this file and replaces the
# placeholder secrets below with freshly generated random values. If you create
# .env by hand, change SESSION_SECRET + the DB passwords yourself before going
# live — the values here are PUBLIC placeholders, not safe defaults.

# ----- Database -----
DB_ROOT_PASSWORD=arcturus_root_pw         # CHANGE ME (setup generates a random value)
DB_USER=arcturus_user
DB_PASSWORD=arcturus_pw                    # CHANGE ME (setup generates a random value)
DB_NAME=habbo
DB_PORT=13306

# ----- CMS -----
# Generate a strong secret, e.g.:  openssl rand -hex 32
SESSION_SECRET=change-me-in-production-0000000000000000   # CHANGE ME (setup generates one)
HOTEL_NAME=RetroTV
# Public URL of the Nitro client (what players' browsers hit).
# Local dev: http://127.0.0.1:1080 — production: https://play.${DOMAIN}
CLIENT_URL=http://127.0.0.1:1080
# Avatar imaging endpoint for CMS thumbnails. Defaults to the public Habbo
# imager (renders any standard figure). Point at a self-hosted imager to keep
# everything on your own domain. In-game avatars are rendered by the client.
IMAGING_URL=https://www.habbo.com/habbo-imaging
# Minimum users.rank considered staff (can access /admin CRM).
ADMIN_MIN_RANK=5

# Hotel language for in-game texts. 'es' uses the bundled official Spanish
# external texts (langs/external_flash_texts_es.txt); 'en' keeps English.
# `make setup` applies it; run `make assets` to (re)generate.
HOTEL_LANG=es

# ----- Production (HTTPS reverse proxy) -----
# Only needed with docker-compose.prod.yml. Your apex/registered domain; the
# stack is served on the subdomains play / crm / assets / swf / ws (point DNS
# A records at the server). Caddy auto-issues TLS certs for each.
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# DOMAIN=retrotv.example.com
#
# Optional: host docker group gid, only if you enable the CMS furni web-upload
# (Docker-socket mount) in docker-compose.prod.yml. Find it with:
#   stat -c '%g' /var/run/docker.sock
# DOCKER_GID=999
