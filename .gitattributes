# Force LF for files executed inside Linux containers, regardless of the
# committer's OS / core.autocrlf setting. Prevents the "can't cd / : not found"
# class of errors when the emulator/client shell scripts get CRLF on Windows.
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.ini           text eol=lf
justfile        text eol=lf
Makefile        text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
entrypoint*     text eol=lf

# Normalize common text by default
*.ts            text
*.tsx           text
*.js            text
*.json          text
*.md            text
